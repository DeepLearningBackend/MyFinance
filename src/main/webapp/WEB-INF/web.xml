<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>MyFinance</display-name>
    <description>Online Personal Finance Management Platform</description>

    <!-- App Startup & Daemon Thread Listener -->
    <listener>
        <listener-class>com.myfinance.listener.AppStartupListener</listener-class>
    </listener>

    <!-- 1. Authentication & Session Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth</url-pattern>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- 2. User Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- 3. Expenses & Transactions Servlet -->
    <servlet>
        <servlet-name>ExpenseServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.ExpenseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExpenseServlet</servlet-name>
        <url-pattern>/expenses</url-pattern>
    </servlet-mapping>

    <!-- 4. Budget & Threshold Limits Servlet -->
    <servlet>
        <servlet-name>BudgetServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.BudgetServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BudgetServlet</servlet-name>
        <url-pattern>/budgets</url-pattern>
    </servlet-mapping>

    <!-- 5. Goals & Motivation Engine Servlet -->
    <servlet>
        <servlet-name>GoalServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.GoalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoalServlet</servlet-name>
        <url-pattern>/goals</url-pattern>
    </servlet-mapping>

    <!-- 6. Admin Command Overview Servlet -->
    <servlet>
        <servlet-name>AdminDashServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.admin.AdminDashServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

    <!-- 7. Admin User Management Servlet -->
    <servlet>
        <servlet-name>UserMgmtServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.admin.UserMgmtServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserMgmtServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <!-- 8. Admin Security & Audit Servlet -->
    <servlet>
        <servlet-name>SecurityServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.admin.SecurityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SecurityServlet</servlet-name>
        <url-pattern>/admin/security</url-pattern>
    </servlet-mapping>

    <!-- 9. Admin System Settings Servlet -->
    <servlet>
        <servlet-name>SettingsServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.admin.SettingsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SettingsServlet</servlet-name>
        <url-pattern>/admin/settings</url-pattern>
    </servlet-mapping>

    <!-- 10. User Profile & API Token Servlet -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- 11. Real-Time Bank SMS Sync API Servlet -->
    <servlet>
        <servlet-name>SmsApiServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.SmsApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SmsApiServlet</servlet-name>
        <url-pattern>/api/sms-sync</url-pattern>
    </servlet-mapping>

    <!-- 12. Cash Tracker Servlet (Innovation 3) -->
    <servlet>
        <servlet-name>CashServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.CashServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CashServlet</servlet-name>
        <url-pattern>/cash</url-pattern>
    </servlet-mapping>

    <!-- 13. Spending Personality Servlet (Innovation 6) -->
    <servlet>
        <servlet-name>PersonalityServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.PersonalityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PersonalityServlet</servlet-name>
        <url-pattern>/personality</url-pattern>
    </servlet-mapping>

    <!-- 14. FinCoach AI & Rule-based Coach Servlet (Innovations 4 & 5) -->
    <servlet>
        <servlet-name>FinCoachServlet</servlet-name>
        <servlet-class>com.myfinance.servlet.FinCoachServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FinCoachServlet</servlet-name>
        <url-pattern>/fincoach</url-pattern>
    </servlet-mapping>

    <!-- Welcome Page Configuration -->
    <welcome-file-list>
        <welcome-file>auth</welcome-file>
    </welcome-file-list>

    <!-- Session Timeout (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Error Handling Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/jsp/error/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>403</error-code>
        <location>/jsp/error/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/jsp/error/500.jsp</location>
    </error-page>

</web-app>
